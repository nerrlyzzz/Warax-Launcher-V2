#include <winres.h>
#include "secrets.h"

1 ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041904b0"
    BEGIN
      VALUE "CompanyName", "Warax"
      VALUE "FileDescription", "Warax Visuals Launcher"
      VALUE "FileVersion", WL_VERSION
      VALUE "InternalName", "WaraxLauncher"
      VALUE "OriginalFilename", "WaraxLauncher.exe"
      VALUE "ProductName", "Warax Visuals"
      VALUE "ProductVersion", WL_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x419, 1200
  END
END
